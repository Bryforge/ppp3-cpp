#!/usr/bin/env bash
set -euo pipefail

# PPP3 GCC shortcut wrapper.
# Intended use after aliasing:
#   alias gcc="$HOME/bin/pppgcc"
#
# From the repository root:
#   gcc ch1/name.cpp
#   ./name
#
# From a chapter folder:
#   cd ch1
#   gcc name.cpp
#   ./name

find_real_gcc() {
    for c in gcc-16 gcc-15 gcc-14 gcc-13 gcc; do
        if command -v "$c" >/dev/null 2>&1; then
            local candidate
            candidate="$(command -v "$c")"
            if "$candidate" --version 2>/dev/null | grep -qi 'gcc'; then
                printf '%s\n' "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

find_repo_root() {
    local d="$CALL_DIR"
    while [[ "$d" != "/" ]]; do
        if [[ -f "$d/PPP.h" && -f "$d/PPP.cxx" ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    return 1
}

has_arg() {
    local wanted="$1"
    shift
    local arg
    for arg in "$@"; do
        [[ "$arg" == "$wanted" ]] && return 0
    done
    return 1
}

has_include_path() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == "-I." || "$arg" == "-I" || "$arg" == -I* ]] && return 0
    done
    return 1
}

to_repo_path() {
    local p="$1"
    local abs dir base

    if [[ "$p" == /* ]]; then
        abs="$p"
    else
        dir="$(dirname "$p")"
        base="$(basename "$p")"
        abs="$(cd "$CALL_DIR/$dir" && pwd -P)/$base"
    fi

    if [[ "$abs" == "$REPO_ROOT/"* ]]; then
        printf '%s\n' "${abs#"$REPO_ROOT/"}"
    else
        printf '%s\n' "$abs"
    fi
}

to_call_output_path() {
    local p="$1"
    if [[ "$p" == /* ]]; then
        printf '%s\n' "$p"
    else
        printf '%s/%s\n' "$CALL_DIR" "$p"
    fi
}

find_std_cc() {
    local printed
    printed="$($REAL_GCC -print-file-name=bits/std.cc 2>/dev/null || true)"
    if [[ -n "$printed" && -f "$printed" ]]; then
        printf '%s\n' "$printed"
        return 0
    fi

    local gcc_include_root
    gcc_include_root="$(dirname "$(dirname "$REAL_GCC")")/include/c++"

    if [[ -d "$gcc_include_root" ]]; then
        find "$gcc_include_root" -path '*/bits/std.cc' -print -quit 2>/dev/null
        return 0
    fi

    for root in /opt/homebrew/Cellar/gcc /usr/local/Cellar/gcc /usr/include/c++; do
        if [[ -d "$root" ]]; then
            find "$root" -path '*/bits/std.cc' -print -quit 2>/dev/null
            return 0
        fi
    done
}

CALL_DIR="$(pwd -P)"
REAL_GCC="$(find_real_gcc || true)"

if [[ -z "${REAL_GCC:-}" ]]; then
    echo "pppgcc: could not find GNU GCC. Install it with Homebrew, e.g. brew install gcc." >&2
    exit 1
fi

REPO_ROOT="$(find_repo_root || true)"

# If this is not inside the PPP3 repo, pass through to real GCC.
if [[ -z "${REPO_ROOT:-}" ]]; then
    exec "$REAL_GCC" "$@"
fi

cpp_files=()
out=""
display_out=""
compile_only=0
raw_args=("$@")
args=()

for ((i=0; i<${#raw_args[@]}; i++)); do
    case "${raw_args[$i]}" in
        -o)
            args+=("-o")
            if (( i + 1 < ${#raw_args[@]} )); then
                out="$(to_call_output_path "${raw_args[$((i+1))]}")"
                display_out="${raw_args[$((i+1))]}"
                args+=("$out")
                ((i++))
            fi
            ;;
        -c)
            compile_only=1
            args+=("${raw_args[$i]}")
            ;;
        *.cpp|*.cc|*.cxx|*.C)
            src="$(to_repo_path "${raw_args[$i]}")"
            cpp_files+=("$src")
            args+=("$src")
            ;;
        *)
            args+=("${raw_args[$i]}")
            ;;
    esac
done

# If this is not compiling C++ source, pass through to real GCC.
if [[ "${#cpp_files[@]}" -eq 0 ]]; then
    exec "$REAL_GCC" "$@"
fi

# If one source file and no -o was given, build ./filename in the caller's directory.
# Examples:
#   repo root: gcc ch1/name.cpp -> ./name
#   ch1/:     gcc name.cpp     -> ./name inside ch1/
if [[ -z "$out" && "${#cpp_files[@]}" -eq 1 && "$compile_only" -eq 0 ]]; then
    src="${cpp_files[0]}"
    base="$(basename "$src")"
    out="$CALL_DIR/${base%.*}"
    display_out="./${base%.*}"
    args+=("-o" "$out")
fi

# Build from the repository root so GCC's module cache is shared at repo_root/gcm.cache.
cd "$REPO_ROOT"

# Make sure C++23 modules are enabled unless caller already supplied them.
final_args=()
if ! has_arg "-std=c++23" "${args[@]}" && ! has_arg "-std=gnu++23" "${args[@]}"; then
    final_args+=("-std=c++23")
fi
if ! has_arg "-fmodules-ts" "${args[@]}"; then
    final_args+=("-fmodules-ts")
fi

# Chapter folders use #include "PPP.h" while PPP.h stays at the repo root.
# Add the repo root as an include path automatically.
if [[ -f "PPP.h" ]] && ! has_include_path "${args[@]}"; then
    final_args+=("-I.")
fi

final_args+=("${args[@]}")

# Build import std support if std.o or gcm.cache/std.gcm is missing.
if [[ "$compile_only" -eq 0 && ( ! -f "std.o" || ! -f "gcm.cache/std.gcm" ) ]]; then
    std_cc="$(find_std_cc || true)"
    if [[ -n "${std_cc:-}" ]]; then
        "$REAL_GCC" -std=c++23 -fmodules-ts -c "$std_cc" -o std.o
    else
        echo "pppgcc: warning: could not find GCC bits/std.cc; std.o was not rebuilt" >&2
    fi
fi

# Build PPP module if this repo has PPP.cxx and PPP.o or gcm.cache/PPP.gcm is missing/stale.
if [[ -f "PPP.cxx" ]]; then
    if [[ ! -f "PPP.o" || ! -f "gcm.cache/PPP.gcm" || "PPP.cxx" -nt "PPP.o" || "PPP_support.h" -nt "PPP.o" ]]; then
        "$REAL_GCC" -std=c++23 -fmodules-ts -c PPP.cxx
    fi
fi

# For final links, add PPP module object files.
if [[ "$compile_only" -eq 0 ]]; then
    if [[ -f "PPP.o" ]] && ! has_arg "PPP.o" "${final_args[@]}"; then
        final_args+=("PPP.o")
    fi
    if [[ -f "std.o" ]] && ! has_arg "std.o" "${final_args[@]}"; then
        final_args+=("std.o")
    fi
    if ! has_arg "-lstdc++" "${final_args[@]}"; then
        final_args+=("-lstdc++")
    fi
fi

"$REAL_GCC" "${final_args[@]}"

if [[ "$compile_only" -eq 0 && -n "$display_out" ]]; then
    echo "Built $display_out"
fi
